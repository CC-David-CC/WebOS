ksu.codes {
	import site_defaults
	header >Cache-Control "no-store"
	header >Cross-Origin-Opener-Policy "same-origin"
	header >Cross-Origin-Embedder-Policy "require-corp"
	@otherDocuments not path / /index.html /assets/desktop/apps/narrator/*/index.html
	header @otherDocuments >Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
	@narratorPortable path /assets/desktop/apps/narrator/*/index.html
	header @narratorPortable >Content-Security-Policy "default-src 'self'; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
	@weatherDesktop path / /index.html
	header @weatherDesktop >Content-Security-Policy "default-src 'self'; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://radar.weather.gov https://opengeo.ncep.noaa.gov https://nowcoast.noaa.gov https://tiles.openfreemap.org https://gibs.earthdata.nasa.gov https://mapservices.weather.noaa.gov; font-src 'self' data:; connect-src 'self' https://noaa-gfs-bdp-pds.s3.amazonaws.com https://noaa-gefs-pds.s3.amazonaws.com https://noaa-cfs-pds.s3.amazonaws.com https://data.ecmwf.int https://opengeo.ncep.noaa.gov https://nowcoast.noaa.gov https://mapservices.weather.noaa.gov https://gibs.earthdata.nasa.gov https://api.weather.gov https://tiles.openfreemap.org https://www.gdacs.org https://mesonet.agron.iastate.edu https://eonet.gsfc.nasa.gov; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'self'"
	@backend path /services/weather/* /api /api/* /gateway /gateway/* /config.json /.well-known/codi-issuer.json /healthz
	handle @backend {
		reverse_proxy 127.0.0.1:38140
	}
	handle {
		root * @PUBLIC_ROOT@
		file_server
	}
}
